<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OthelloConsole.Converters"
             x:Class="OthelloConsole.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <conv:GameModeConverter   x:Key="GameModeConverter" />
    <conv:AiStrengthConverter x:Key="AiStrengthConverter" />
    <conv:PieceColorConverter x:Key="PieceColorConverter" />
    <conv:HasPieceConverter   x:Key="HasPieceConverter" />
    <conv:LastMoveBgConverter x:Key="LastMoveBgConverter" />
    <conv:IsPvAiConverter     x:Key="IsPvAiConverter" />
    <conv:HasAiConverter      x:Key="HasAiConverter" />
  </Application.Resources>
</Application>
